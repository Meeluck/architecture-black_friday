    {
      "id": "1XyAbOhd7lcSaNumEN_rW",
      "type": "text",
      "x": -622.8678588867188,
      "y": 247.5,
      "width": 785.7357177734375,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
